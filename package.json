{
  "name": "git-project-manager",
  "version": "1.0.4",
  "description": "本地 Git 项目与分支管理工具（支持 Codeup / GitLab / Gitee / GitHub / 通用 Git，令牌加密存本地）",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "test": "node scripts/test.js",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "npm run build && node scripts/desktop-build.js",
    "desktop:win": "npm run desktop:build -- --win --x64 --publish never",
    "desktop:mac": "npm run desktop:build -- --mac --publish never",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@vscode/ripgrep": "^1.18.0",
    "electron-updater": "^6.8.11",
    "gsap": "^3.13.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.74.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.12.0",
    "re2-wasm": "^1.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.8",
    "tar": "^7.5.23",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "author": "文可颂",
  "overrides": {
    "dompurify": "3.4.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wenkesong-li/git-project-manager.git"
  },
  "homepage": "https://github.com/wenkesong-li/git-project-manager#readme",
  "bugs": {
    "url": "https://github.com/wenkesong-li/git-project-manager/issues"
  }
}
